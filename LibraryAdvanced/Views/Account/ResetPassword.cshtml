@model LibraryAdvanced.ViewModels.ResetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - Library</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="login-page">
        <div class="login-card">

            <!-- LOGO -->
            <div class="login-logo">
                📚
            </div>

            <!-- TITLE -->
            <h1>LIBRARY</h1>

            <a asp-controller="Home"
               asp-action="Landing"
               class="back-to-landing">
                ← Quay về trang chủ
            </a>

            <p class="login-subtitle">
                Library Management
            </p>

            <!-- TITLE H2 -->
            <h2>Đặt lại mật khẩu</h2>

            <p class="login-description">
                Vui lòng nhập mật khẩu mới cho tài khoản của bạn.
            </p>

            <!-- ERROR SUMMARY -->
            <div asp-validation-summary="ModelOnly" class="login-error mb-3 text-danger"></div>

            <!-- FORM -->
            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()

                <!-- HIDDEN FIELDS (Giữ Token và Email) -->
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <!-- MẬT KHẨU MỚI -->
                <div class="login-form-group">
                    <label asp-for="NewPassword">
                        Mật khẩu mới
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="login-input"
                           placeholder="Nhập mật khẩu mới..." />

                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <!-- XÁC NHẬN MẬT KHẨU MỚI -->
                <div class="login-form-group">
                    <label asp-for="ConfirmPassword">
                        Xác nhận mật khẩu mới
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="login-input"
                           placeholder="Xác nhận mật khẩu mới..." />

                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- BUTTON -->
                <button type="submit" class="login-button">
                    Cập nhật mật khẩu
                </button>
            </form>

            <!-- LINK BACK TO LOGIN -->
            <div class="register-link">
                Nhớ lại mật khẩu?
                <a asp-controller="Account" asp-action="Login">
                    Đăng nhập ngay
                </a>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>