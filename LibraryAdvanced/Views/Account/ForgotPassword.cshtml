@model LibraryAdvanced.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - Library</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="login-page">
        <div class="login-card">

            <!-- LOGO -->
            <div class="login-logo">
                📚
            </div>

            <!-- TITLE -->
            <h1>LIBRARY</h1>

            <a asp-controller="Home"
               asp-action="Landing"
               class="back-to-landing">
                ← Quay về trang chủ
            </a>

            <p class="login-subtitle">
                Library Management
            </p>

            <!-- TITLE H2 -->
            <h2>Quên mật khẩu</h2>

            <p class="login-description">
                Nhập email tài khoản của bạn để nhận liên kết đặt lại mật khẩu.
            </p>

            <!-- THÔNG BÁO THÀNH CÔNG (Sau khi gửi Mail) -->
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success text-center my-3" style="font-size: 0.9rem;">
                    @ViewBag.Message
                </div>

                <div class="register-link mt-4">
                    <a asp-controller="Account" asp-action="Login">
                        ← Quay lại trang Đăng nhập
                    </a>
                </div>
            }
            else
            {
                <!-- ERROR SUMMARY -->
                <div asp-validation-summary="ModelOnly" class="login-error mb-3 text-danger"></div>

                <!-- FORM -->
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <!-- EMAIL INPUT -->
                    <div class="login-form-group">
                        <label asp-for="Email">
                            Địa chỉ Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="login-input"
                               placeholder="Nhập email của bạn..." />

                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- BUTTON -->
                    <button type="submit" class="login-button">
                        Gửi liên kết khôi phục
                    </button>
                </form>

                <!-- LINK BACK TO LOGIN -->
                <div class="register-link">
                    Đã nhớ mật khẩu?
                    <a asp-controller="Account" asp-action="Login">
                        Đăng nhập ngay
                    </a>
                </div>
            }

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>