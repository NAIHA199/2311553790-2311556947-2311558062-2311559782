@{
    ViewData["Title"] = "Trang chủ";
    var userRole = ViewBag.UserRole as string;
    var displayName = ViewBag.DisplayName as string;
}

<div class="home-page">

    <!-- WELCOME -->
    <div class="home-welcome">

        <div>
            @if (userRole == "Reader")
            {
                <span class="welcome-label">
                    CỬ NHÂN ĐỌC GIẢ
                </span>

                <h1>
                    Xin chào, @displayName 👋
                </h1>

                <p>
                    Quản lý sách đang mượn và khám phá những cuốn sách
                    hay trong thư viện.
                </p>
            }
            else
            {
                <span class="welcome-label">
                    QUẢN TRỊ VIÊN
                </span>

                <h1>
                    Chào mừng bạn đến với Dashboard 📊
                </h1>

                <p>
                    Quản lý hệ thống thư viện, theo dõi các phiếu mượn
                    và xem thống kê chi tiết.
                </p>
            }

            <a asp-controller="Books"
               asp-action="Index"
               class="home-button">
                Xem sách →
            </a>
        </div>

        <div class="welcome-icon">
            @if (userRole == "Reader")
            {
                <span>👤</span>
            }
            else
            {
                <span>👑</span>
            }
        </div>

    </div>


    <!-- QUICK INFO -->
    <div class="home-stats">

        <div class="home-stat">

            <div class="stat-icon">
                📚
            </div>

            <div>
                <span>Tổng số sách</span>
                <strong>@ViewBag.TotalBooks</strong>
            </div>

        </div>


        <div class="home-stat">

            <div class="stat-icon">
                📖
            </div>

            <div>
                <span>
                    @if (userRole == "Reader")
                    {
                        <text>Sách đang mượn</text>
                    }
                    else
                    {
                        <text>Tổng sách đang mượn</text>
                    }
                </span>
                <strong>@ViewBag.BorrowedBooks</strong>
            </div>

        </div>


        <div class="home-stat">

            <div class="stat-icon">
                📋
            </div>

            <div>
                <span>
                    @if (userRole == "Reader")
                    {
                        <text>Lịch sử mượn</text>
                    }
                    else
                    {
                        <text>Tổng lượt mượn</text>
                    }
                </span>
                <strong>@ViewBag.TotalLoans</strong>
            </div>

        </div>

    </div>


    <!-- FEATURED BOOKS -->
    <div class="home-section">

        <div class="section-header">

            <div>
                <span class="section-label">
                    KHÁM PHÁ
                </span>

                <h2>
                    Sách nổi bật
                </h2>
            </div>

            <a asp-controller="Books"
               asp-action="Index"
               class="view-all">
                Xem tất cả →
            </a>

        </div>


        <div class="simple-book-grid">

            @{
                var books = ViewBag.FeaturedBooks as List<LibraryAdvanced.Models.Book> 
                    ?? new List<LibraryAdvanced.Models.Book>();
            }

            @if (books.Any())
            {
                @foreach (var book in books)
                {
                    <a asp-controller="Books"
                       asp-action="Details"
                       asp-route-id="@book.Id"
                       class="simple-book-card">

                        <div class="book-image">
                            @if (!string.IsNullOrEmpty(book.ImagePath))
                            {
                                <img src="@book.ImagePath" 
                                     alt="@book.Title"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('hidden');" />
                            }
                            <span class="@(string.IsNullOrEmpty(book.ImagePath) ? "" : "hidden")">
                                📚
                            </span>
                        </div>

                        <div class="book-info">

                            <h3>
                                @book.Title
                            </h3>

                            <p>
                                @book.Author
                            </p>

                        </div>

                    </a>
                }
            }
            else
            {
                <div class="simple-book-card">
                    <div class="book-image">📚</div>
                    <div class="book-info">
                        <h3>Chưa có sách</h3>
                        <p>Vui lòng thêm sách</p>
                    </div>
                </div>
            }

        </div>

    </div>


    <!-- CATEGORY -->
    <div class="home-section">

        <div class="section-header">

            <div>
                <span class="section-label">
                    DANH MỤC
                </span>

                <h2>
                    Khám phá theo thể loại
                </h2>
            </div>

        </div>


        <div class="category-list">

            @{
                var categories = ViewBag.Categories as List<LibraryAdvanced.Models.Category> 
                    ?? new List<LibraryAdvanced.Models.Category>();
            }

            @if (categories.Any())
            {
                @foreach (var category in categories)
                {
                    <a asp-controller="Books"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id"
                       class="category-item">
                        <span>📚</span>
                        <div>
                            <strong>@category.Name</strong>
                            <small>Thể loại: @category.Name</small>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="category-item">
                    <span>📚</span>
                    <div>
                        <strong>Chưa có danh mục</strong>
                        <small>Vui lòng thêm danh mục</small>
                    </div>
                </div>
            }

        </div>

    </div>

</div>