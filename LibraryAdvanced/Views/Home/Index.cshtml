@{
    ViewData["Title"] = "Trang chủ";
}

<div class="home-page">

    <!-- WELCOME -->
    <div class="home-welcome">

        <div>
            <span class="welcome-label">
                THƯ VIỆN TRỰC TUYẾN
            </span>

            <h1>
                Chào mừng bạn đến với thư viện 📚
            </h1>

            <p>
                Khám phá những cuốn sách hay và quản lý
                sách bạn đang mượn một cách dễ dàng.
            </p>

            <a asp-controller="Books"
               asp-action="Index"
               class="home-button">
                Xem sách →
            </a>
        </div>

        <div class="welcome-icon">
            📚
        </div>

    </div>


    <!-- QUICK INFO -->
    <div class="home-stats">
        <!-- DEBUG -->
        <div style="display:none;">
            TotalBooks: @ViewBag.TotalBooks | 
            BorrowedBooks: @ViewBag.BorrowedBooks | 
            TotalLoans: @ViewBag.TotalLoans | 
            UserRole: @ViewBag.UserRole | 
            DisplayName: @ViewBag.DisplayName
        </div>

        <div class="home-stat">

            <div class="stat-icon">
                📚
            </div>

            <div>
                <span>Tổng số sách</span>
                <strong>@ViewBag.TotalBooks</strong>
            </div>

        </div>


        <div class="home-stat">

            <div class="stat-icon">
                📖
            </div>

            <div>
                <span>
                    @{
                        var userRole = ViewBag.UserRole as string;
                    }
                    @if (userRole == "Reader")
                    {
                        <text>Sách đang mượn</text>
                    }
                    else
                    {
                        <text>Tổng sách đang mượn</text>
                    }
                </span>
                <strong>@ViewBag.BorrowedBooks</strong>
            </div>

        </div>


        <div class="home-stat">

            <div class="stat-icon">
                📋
            </div>

            <div>
                <span>
                    @if (userRole == "Reader")
                    {
                        <text>Lịch sử mượn</text>
                    }
                    else
                    {
                        <text>Tổng lượt mượn</text>
                    }
                </span>
                <strong>@ViewBag.TotalLoans</strong>
            </div>

        </div>

    </div>


    <!-- FEATURED BOOKS -->
    <div class="home-section">

        <div class="section-header">

            <div>
                <span class="section-label">
                    KHÁM PHÁ
                </span>

                <h2>
                    Sách nổi bật
                </h2>
            </div>

            <a asp-controller="Books"
               asp-action="Index"
               class="view-all">
                Xem tất cả →
            </a>

        </div>


        <div class="featured-books-list">

            @{
                var featuredBooks = ViewBag.FeaturedBooks as List<Book> ?? new List<Book>();
            }

            @if (featuredBooks.Count > 0)
            {
                @foreach (var book in featuredBooks)
                {
                    <div class="featured-book-card">

                        <div class="featured-book-image">
                            @if (!string.IsNullOrEmpty(book.ImagePath))
                            {
                                <img src="@book.ImagePath" alt="@book.Title" class="book-image-full" />
                                <div class="book-icon-fallback">📖</div>
                            }
                            else
                            {
                                <div class="book-icon-fallback">📖</div>
                            }
                        </div>

                        <div class="featured-book-content">

                            <div class="featured-book-header">
                                <span class="featured-book-label">@(Model?.CategoryName ?? "Lập trình")</span>
                            </div>

                            <h3 class="featured-book-title">
                                @book.Title
                            </h3>

                            <p class="featured-book-author">
                                @book.Author
                            </p>

                            <div class="featured-book-footer">
                                <span class="featured-book-available">
                                    Còn 14 cuốn
                                </span>
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="featured-book-link">
                                    Chi tiết →
                                </a>
                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <p style="text-align: center; padding: 40px; color: #999;">
                    Chưa có sách nào
                </p>
            }

        </div>

    </div>


    <!-- CATEGORY -->
    <div class="home-section">

        <div class="section-header">

            <div>
                <span class="section-label">
                    DANH MỤC
                </span>

                <h2>
                    Khám phá theo thể loại
                </h2>
            </div>

        </div>


        <div class="category-list">

            @{
                var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
            }

            @if (categories.Count > 0)
            {
                @foreach (var category in categories)
                {
                    <a asp-controller="Books" asp-action="Index" asp-route-search="" asp-route-category="@category.Id" class="category-item">
                        <span>📚</span>
                        <div>
                            <strong>@category.Name</strong>
                            <small>Danh mục sách</small>
                        </div>
                    </a>
                }
            }
            else
            {
                <p style="grid-column: 1/-1; text-align: center; padding: 20px; color: #999;">
                    Chưa có danh mục nào
                </p>
            }

        </div>

    </div>

</div>