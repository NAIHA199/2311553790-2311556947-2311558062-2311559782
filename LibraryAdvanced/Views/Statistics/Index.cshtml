@model LibraryAdvanced.ViewModel.StatisticsViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Thống kê thư viện";

    var chartData =
        ViewBag.ChartData
        ?? new List<object>();

    var tuNgay =
        ViewBag.TuNgay as string
        ?? DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");

    var denNgay =
        ViewBag.DenNgay as string
        ?? DateTime.Now.ToString("yyyy-MM-dd");

    var chartJson =
        JsonSerializer.Serialize(chartData);
}


<div class="statistics-page">


    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="statistics-header">

        <span class="page-label">
            QUẢN TRỊ
        </span>

        <h1>
            Thống kê thư viện
        </h1>

        <p>
            Tổng quan hoạt động mượn sách trong thư viện.
        </p>

    </div>



    <!-- =========================================
         1. SÁCH ĐANG MƯỢN
    ========================================== -->

    <div class="row my-4">

        <div class="col-md-6">

            <div class="card text-white bg-primary mb-3">

                <div class="card-header">
                    Sách Đang Được Mượn
                </div>

                <div class="card-body">

                    <h3 class="card-title">
                        @Model.TotalActiveBorrowedBooks Cuốn
                    </h3>

                    <p class="card-text">
                        Tổng số lượng sách thuộc các
                        phiếu mượn chưa trả
                        ('Borrowed').
                    </p>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================
         2. TOP 3
    ========================================== -->

    <h3 class="statistics-section-title">
        Top 3 Cuốn Sách Mượn Nhiều Nhất
    </h3>


    <table class="table table-striped table-hover mt-3">

        <thead class="table-dark">

            <tr>

                <th>#</th>

                <th>Tên Sách</th>

                <th>
                    Tổng Số Lượt / Số Lượng Đã Mượn
                </th>

            </tr>

        </thead>


        <tbody>

            @{
                int index = 1;
            }

            @foreach (var book in Model.Top3Books)
            {
                <tr>

                    <td>
                        @(index++)
                    </td>

                    <td>
                        <strong>
                            @book.BookTitle
                        </strong>
                    </td>

                    <td>

                        <span class="badge bg-success fs-6">
                            @book.TotalBorrowedQuantity
                        </span>

                    </td>

                </tr>
            }

        </tbody>

    </table>



    <!-- =========================================
         3. BIỂU ĐỒ
    ========================================== -->

    <div class="statistics-chart-card mt-5">


        <div class="statistics-card-header">

            <div>

                <h3>
                    📊 Số Lượng Sách Được Mượn
                </h3>

                <p>
                    Thống kê theo khoảng thời gian.
                </p>

            </div>

        </div>



        <!-- =====================================
             FILTER NGÀY
        ====================================== -->

        <div class="statistics-filter">


            <!-- TỪ NGÀY -->

            <div class="statistics-filter-item">

                <label for="tuNgay">
                    Từ ngày
                </label>

                <input id="tuNgay"
                       type="date"
                       class="form-control"
                       value="@tuNgay" />

            </div>



            <!-- ĐẾN NGÀY -->

            <div class="statistics-filter-item">

                <label for="denNgay">
                    Đến ngày
                </label>

                <input id="denNgay"
                       type="date"
                       class="form-control"
                       value="@denNgay" />

            </div>



            <!-- BUTTON -->

            <div class="statistics-filter-button">

                <!-- TRA CỨU -->

                <button type="button"
                        id="btnTraCuu"
                        class="btn btn-primary">

                    🔍 Tra cứu

                </button>


                <!-- XUẤT EXCEL -->

                <a href="#"
                   id="btnExportExcel"
                   class="btn btn-success">

                    📊 Xuất Excel

                </a>

            </div>

        </div>



        <!-- =====================================
             CHART
        ====================================== -->

        <div class="chart-container">

            <canvas id="myChart"></canvas>

        </div>


    </div>

</div>



<!-- =========================================
     CHART.JS
========================================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>



@section Scripts {

    <script>

        let myChart = null;


        // =====================================
        // VẼ BIỂU ĐỒ
        // =====================================

        function drawChart(data) {

            console.log(
                "DATA NHẬN ĐƯỢC:",
                data
            );


            const labels =
                data.map(item =>
                    item.bookTitle ?? item.BookTitle
                );


            const values =
                data.map(item =>
                    item.soLuongMuon ?? item.SoLuongMuon
                );


            console.log(
                "LABELS:",
                labels
            );

            console.log(
                "VALUES:",
                values
            );


            const canvas =
                document.getElementById(
                    "myChart"
                );


            if (!canvas) {

                console.error(
                    "Không tìm thấy canvas #myChart"
                );

                return;
            }


            // XÓA BIỂU ĐỒ CŨ

            if (myChart !== null) {

                myChart.destroy();

            }


            // TẠO BIỂU ĐỒ MỚI

            myChart =
                new Chart(
                    canvas,
                    {

                        type: "bar",

                        data: {

                            labels: labels,

                            datasets: [{

                                label:
                                    "Số lượng sách được mượn",

                                data: values,

                                borderWidth: 1

                            }]

                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio: false,

                            scales: {

                                y: {

                                    beginAtZero: true,

                                    ticks: {

                                        precision: 0

                                    }

                                }

                            }

                        }

                    }
                );

        }



        // =====================================
        // DOCUMENT READY
        // =====================================

        $(document).ready(function() {


            // =================================
            // TRA CỨU
            // =================================

            $("#btnTraCuu").on(
                "click",
                function() {


                    const tuNgay =
                        $("#tuNgay").val();


                    const denNgay =
                        $("#denNgay").val();


                    console.log(
                        "Từ ngày:",
                        tuNgay
                    );


                    console.log(
                        "Đến ngày:",
                        denNgay
                    );


                    // KIỂM TRA NGÀY

                    if (!tuNgay ||
                        !denNgay) {

                        alert(
                            "Vui lòng chọn đầy đủ ngày."
                        );

                        return;
                    }


                    // KIỂM TRA KHOẢNG NGÀY

                    if (tuNgay > denNgay) {

                        alert(
                            "Từ ngày không được lớn hơn đến ngày."
                        );

                        return;
                    }


                    // AJAX

                    $.ajax({

                        url:
                            "/Statistics/GetBorrowedBooksChart",

                        type:
                            "GET",

                        data: {

                            TuNgay:
                                tuNgay,

                            DenNgay:
                                denNgay

                        },


                        success:
                            function(data) {

                                console.log(
                                    "API TRẢ VỀ:",
                                    data
                                );


                                drawChart(
                                    data
                                );

                            },


                        error:
                            function(xhr) {

                                console.error(
                                    "API ERROR:",
                                    xhr.status,
                                    xhr.responseText
                                );


                                alert(
                                    "Không tải được dữ liệu biểu đồ."
                                );

                            }

                    });

                }
            );



            // =================================
            // XUẤT EXCEL
            // =================================

            $("#btnExportExcel").on(
                "click",
                function(e) {

                    e.preventDefault();


                    // LẤY NGÀY ĐANG CHỌN

                    const tuNgay =
                        $("#tuNgay").val();


                    const denNgay =
                        $("#denNgay").val();


                    // KIỂM TRA

                    if (!tuNgay ||
                        !denNgay) {

                        alert(
                            "Vui lòng chọn đầy đủ ngày trước khi xuất báo cáo."
                        );

                        return;
                    }


                    // KIỂM TRA KHOẢNG NGÀY

                    if (tuNgay > denNgay) {

                        alert(
                            "Từ ngày không được lớn hơn đến ngày."
                        );

                        return;
                    }


                    console.log(
                        "Xuất Excel:",
                        tuNgay,
                        denNgay
                    );


                    // TẠO URL

                    const url =
                        "/Statistics/ExportExcel"
                        + "?TuNgay="
                        + encodeURIComponent(
                            tuNgay
                        )
                        + "&DenNgay="
                        + encodeURIComponent(
                            denNgay
                        );


                    // TẢI FILE

                    window.location.href =
                        url;

                }
            );


        });

    </script>

}