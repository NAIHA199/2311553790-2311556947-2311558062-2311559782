@model LibraryAdvanced.ViewModel.StatisticsViewModel

<h2>Thống Kê Thư Viện (Dashboard)</h2>

<div class="row my-4">
    <div class="col-md-6">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Sách Đang Được Mượn</div>
            <div class="card-body">
                <h3 class="card-title">@Model.TotalActiveBorrowedBooks Cuốn</h3>
                <p class="card-text">Tổng số lượng sách thuộc các phiếu mượn chưa trả ('Borrowed').</p>
            </div>
        </div>
    </div>
</div>

<h3>Top 3 Cuốn Sách Mượn Nhiều Nhất </h3>
<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Tên Sách</th>
            <th>Tổng Số Lượt / Số Lượng Đã Mượn</th>
        </tr>
    </thead>
    <tbody>
        @{
            int index = 1;
        }
        @foreach (var book in Model.Top3Books)
        {
            <tr>
                <td>@(index++)</td>
                <td><strong>@book.BookTitle</strong></td>
                <td><span class="badge bg-success fs-6">@book.TotalBorrowedQuantity</span></td>
            </tr>
        }
    </tbody>
</table>