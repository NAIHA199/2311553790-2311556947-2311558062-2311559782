@model LibraryAdvanced.ViewModel.CreateBookViewModel

@{
    ViewData["Title"] = "Thêm sách";
}

<div class="admin-book-header">

    <span>
        QUẢN TRỊ
    </span>

    <h1>
        Thêm sách
    </h1>

    <p>
        Thêm một cuốn sách mới vào thư viện.
    </p>

</div>


<div class="admin-book-card">

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()


        <!-- VALIDATION -->

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- TITLE -->

        <div class="admin-form-group">

            <label asp-for="Title">
                Tên sách
            </label>

            <input asp-for="Title"
                   class="form-control"
                   placeholder="Nhập tên sách..." />

            <span asp-validation-for="Title"
                  class="text-danger">
            </span>

        </div>


        <!-- AUTHOR -->

        <div class="admin-form-group">

            <label asp-for="Author">
                Tác giả
            </label>

            <input asp-for="Author"
                   class="form-control"
                   placeholder="Nhập tên tác giả..." />

            <span asp-validation-for="Author"
                  class="text-danger">
            </span>

        </div>


        <!-- CATEGORY -->

        <div class="admin-form-group">

            <label asp-for="CategoryId">
                Danh mục
            </label>

            <select asp-for="CategoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">

                <option value="">
                    -- Chọn danh mục --
                </option>

            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger">
            </span>

        </div>


        <!-- QUANTITY -->

        <div class="admin-form-group">

            <label asp-for="AvailableQuantity">
                Số lượng
            </label>

            <input asp-for="AvailableQuantity"
                   type="number"
                   min="0"
                   class="form-control"
                   placeholder="Nhập số lượng sách..." />

            <span asp-validation-for="AvailableQuantity"
                  class="text-danger">
            </span>

        </div>

        <!-- IMAGE -->

        <div class="admin-form-group">

            <label asp-for="ImageFile">
                Ảnh bìa
            </label>

            <input asp-for="ImageFile"
                   type="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="text-muted">
                JPG, JPEG, PNG, WEBP
            </small>

            <span asp-validation-for="ImageFile"
                  class="text-danger">
            </span>

        </div>


        <!-- BUTTON -->

        <div class="admin-form-actions">

            <a asp-action="Index"
               class="admin-cancel">

                Hủy

            </a>

            <button type="submit"
                    class="btn btn-primary">

                + Thêm sách

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}