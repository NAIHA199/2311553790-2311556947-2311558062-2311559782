@model LibraryManagement.ViewModels.CreateLoanTicketViewModel

@{
    ViewData["Title"] = "Mượn sách";

    var books =
        ViewBag.Books as List<LibraryAdvanced.Models.Book>
        ?? new List<LibraryAdvanced.Models.Book>();
}


<div class="loan-create-page">

    <!-- HEADER -->

    <div class="loan-create-header">

        <a asp-controller="Books"
           asp-action="Index"
           class="back-link">

            ← Quay lại danh sách sách

        </a>


        <span class="page-label">
            THƯ VIỆN
        </span>


        <h1>
            Mượn sách
        </h1>


        <p>
            Điền thông tin để tạo phiếu mượn sách.
        </p>

    </div>



    <!-- FORM -->

    <div class="loan-create-card">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>



            <!-- NGƯỜI MƯỢN -->

            <div class="loan-form-group">

                <label asp-for="BorrowerName">
                    Tên người mượn
                </label>

                <input asp-for="BorrowerName"
                       class="form-control"
                       placeholder="Nhập tên người mượn..." />

                <span asp-validation-for="BorrowerName"
                      class="text-danger">
                </span>

            </div>



            <!-- SÁCH -->

            <div class="loan-books-header">

                <div>

                    <label>
                        Sách mượn
                    </label>

                    <small>
                        Có thể chọn nhiều sách trong cùng một phiếu.
                    </small>

                </div>


                <button type="button"
                        id="addBookButton"
                        class="add-book-button">

                    + Thêm sách

                </button>

            </div>



            <!-- DANH SÁCH DÒNG SÁCH -->

            <div id="bookRows">


                <!-- DÒNG ĐẦU TIÊN -->

                <div class="loan-book-row">


                    <div class="loan-book-select">

                        <select name="Details[0].BookId"
                                class="form-select book-select"
                                required>

                            <option value="">
                                -- Chọn sách --
                            </option>


                            @foreach (var book in books)
                            {
                                <option value="@book.Id">

                                    @book.Title
                                    - Còn @book.AvailableQuantity cuốn

                                </option>
                            }

                        </select>

                    </div>



                    <div class="loan-quantity">

                        <input type="number"
                               name="Details[0].Quantity"
                               class="form-control"
                               value="1"
                               min="1"
                               required />

                    </div>



                    <button type="button"
                            class="remove-book-button"
                            title="Xóa sách">

                        🗑️

                    </button>


                </div>


            </div>



            <!-- TỔNG -->

            <div class="loan-total">

                <span>
                    Tổng số loại sách:
                </span>

                <strong id="bookTypeCount">
                    1
                </strong>

            </div>



            <!-- BUTTON -->

            <div class="loan-form-actions">

                <a asp-controller="LoanTickets"
                   asp-action="Index"
                   class="loan-cancel-button">

                    Hủy

                </a>


                <button type="submit"
                        class="loan-submit-button">

                    ✓ Xác nhận mượn

                </button>

            </div>


        </form>

    </div>

</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        // =========================================
        // BOOK DATA
        // =========================================

        const books = [
                    @foreach (var book in books)
            {
                <text>
                        {
                            id: @book.Id,
                        title: "@Html.Raw(
                                    System.Text.Encodings.Web
                                    .JavaScriptEncoder.Default
                                    .Encode(book.Title)
                                    )",
                        quantity: @book.AvailableQuantity
                                },
                </text>
                    }
                ];


        // =========================================
        // ELEMENTS
        // =========================================

        const bookRows =
            document.getElementById("bookRows");

        const addBookButton =
            document.getElementById("addBookButton");

        const bookTypeCount =
            document.getElementById("bookTypeCount");



        // =========================================
        // UPDATE INDEX
        // =========================================

        function updateIndexes() {
            const rows =
                bookRows.querySelectorAll(
                    ".loan-book-row"
                );


            rows.forEach((row, index) => {
                const select =
                    row.querySelector(".book-select");

                const quantity =
                    row.querySelector(
                        "input[type='number']"
                    );


                select.name =
                    `Details[${index}].BookId`;


                quantity.name =
                    `Details[${index}].Quantity`;
            });


            bookTypeCount.textContent =
                rows.length;
        }



        // =========================================
        // ADD BOOK
        // =========================================

        addBookButton.addEventListener(
            "click",
            function() {
                const rows =
                    bookRows.querySelectorAll(
                        ".loan-book-row"
                    );


                const index =
                    rows.length;


                const row =
                    document.createElement("div");


                row.className =
                    "loan-book-row";


                let options =
                    `<option value="">
                                -- Chọn sách --
                            </option>`;


                books.forEach(book => {
                    options += `
                                <option value="${book.id}">
                                    ${escapeHtml(book.title)}
                                    - Còn ${book.quantity} cuốn
                                </option>
                            `;
                });


                row.innerHTML = `

                            <div class="loan-book-select">

                                <select
                                    name="Details[${index}].BookId"
                                    class="form-select book-select"
                                    required>

                                    ${options}

                                </select>

                            </div>


                            <div class="loan-quantity">

                                <input
                                    type="number"
                                    name="Details[${index}].Quantity"
                                    class="form-control"
                                    value="1"
                                    min="1"
                                    required />

                            </div>


                            <button
                                type="button"
                                class="remove-book-button"
                                title="Xóa sách">

                                🗑️

                            </button>

                        `;


                bookRows.appendChild(row);


                updateIndexes();
            }
        );



        // =========================================
        // REMOVE BOOK
        // =========================================

        bookRows.addEventListener(
            "click",
            function(event) {
                const button =
                    event.target.closest(
                        ".remove-book-button"
                    );


                if (!button) {
                    return;
                }


                const rows =
                    bookRows.querySelectorAll(
                        ".loan-book-row"
                    );


                // Không cho xóa dòng cuối cùng
                if (rows.length <= 1) {
                    alert(
                        "Phiếu mượn phải có ít nhất một sách."
                    );

                    return;
                }


                button
                    .closest(".loan-book-row")
                    .remove();


                updateIndexes();
            }
        );



        // =========================================
        // TRÁNH CHỌN TRÙNG SÁCH
        // =========================================

        bookRows.addEventListener(
            "change",
            function(event) {
                if (!event.target.classList.contains(
                    "book-select"
                )) {
                    return;
                }


                const selects =
                    bookRows.querySelectorAll(
                        ".book-select"
                    );


                const values = [];


                selects.forEach(select => {
                    if (select.value) {
                        values.push(select.value);
                    }
                });


                const duplicates =
                    values.some(
                        (value, index) =>
                            values.indexOf(value)
                            !== index
                    );


                if (duplicates) {
                    alert(
                        "Bạn không thể chọn trùng cùng một sách."
                    );


                    event.target.value = "";
                }
            }
        );



        // =========================================
        // ESCAPE HTML
        // =========================================

        function escapeHtml(text) {
            const div =
                document.createElement("div");

            div.textContent = text;

            return div.innerHTML;
        }

    </script>
}