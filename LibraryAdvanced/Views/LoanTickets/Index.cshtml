@model IEnumerable<LibraryAdvanced.ViewModels.LoanTicketListViewModel>

@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Danh Sách Phiếu Mượn";

    var role = Context.Session.GetString("Role");
}


<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Danh Sách Phiếu Mượn
        </h2>


        <!-- ADMIN: TẠO PHIẾU TRẢ -->
        @if (role == "Admin")
        {
            <a asp-controller="LoanTickets"
               asp-action="Return"
               class="btn btn-success">

                ↩ Tạo Phiếu Trả Sách

            </a>
        }

    </div>



    <!-- FORM TÌM KIẾM + LỌC -->

    <form method="get"
          asp-controller="LoanTickets"
          asp-action="Index"
          class="row g-3 mb-4">

        <!-- TÌM KIẾM -->

        <div class="col-md-4">

            <input type="text"
                   name="searchString"
                   value="@ViewBag.SearchString"
                   class="form-control"
                   placeholder="Tìm theo tên người mượn..." />

        </div>


        <!-- TRẠNG THÁI -->

        <div class="col-md-3">

            <select name="statusFilter"
                    class="form-select">

                <option value="All"
                        selected="@(ViewBag.StatusFilter == "All" ? "selected" : null)">

                    -- Tất cả trạng thái --

                </option>


                <option value="Borrowed"
                        selected="@(ViewBag.StatusFilter == "Borrowed" ? "selected" : null)">

                    Borrowed (Đang mượn)

                </option>


                <option value="Returned"
                        selected="@(ViewBag.StatusFilter == "Returned" ? "selected" : null)">

                    Returned (Đã trả)

                </option>

            </select>

        </div>


        <!-- BUTTON -->

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-secondary">

                Tìm kiếm

            </button>

        </div>

    </form>



    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }



    <!-- TABLE -->

    <div class="loan-table-wrapper">

        <table class="loan-table">

            <thead>

                <tr>

                    <th style="width: 80px;">
                        Mã Phiếu
                    </th>

                    <th>
                        Người Mượn
                    </th>

                    <th style="width: 120px;">
                        Ngày Mượn
                    </th>

                    <th style="min-width: 250px;">
                        Sách Mượn
                    </th>

                    <th style="width: 100px;">
                        Trạng Thái
                    </th>

                    <th style="width: 70px;">
                        Tổng
                    </th>

                    <!-- THÊM CỘT IN PHIẾU -->

                    <th style="width: 130px;">
                        Thao tác
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="loan-row"
                            data-loan-id="@item.Id">


                            <!-- MÃ PHIẾU -->

                            <td>

                                <strong>
                                    @item.Id
                                </strong>

                            </td>


                            <!-- NGƯỜI MƯỢN -->

                            <td>

                                @item.BorrowerName

                            </td>


                            <!-- NGÀY MƯỢN -->

                            <td>

                                @item.BorrowDate?.ToString("dd/MM/yyyy")

                            </td>


                            <!-- SÁCH MƯỢN -->

                            <td>

                                <div class="loan-books-display">

                                    <button type="button"
                                            class="btn-toggle-books"
                                            data-loan-id="@item.Id"
                                            onclick="toggleLoanDetails(this)">

                                        ▼

                                    </button>

                                    <span class="books-count">

                                        @item.LoanDetails.Count sách

                                    </span>

                                </div>


                                <div class="loan-books-list hidden"
                                     id="books-@item.Id">

                                    @foreach (var detail in item.LoanDetails)
                                    {
                                        <div class="book-item">

                                            📖 @detail.BookTitle

                                            <span class="quantity">
                                                × @detail.Quantity
                                            </span>

                                        </div>
                                    }

                                </div>

                            </td>


                            <!-- TRẠNG THÁI -->

                            <td>

                                @if (item.Status == "Borrowed")
                                {
                                    <span class="badge bg-warning text-dark">

                                        Borrowed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">

                                        Returned

                                    </span>
                                }

                            </td>


                            <!-- TỔNG SỐ LƯỢNG -->

                            <td>

                                <strong>
                                    @item.TotalQuantity
                                </strong>

                            </td>


                            <!-- IN PHIẾU -->

                            <td>

                                @if (role == "Admin" && item.Status == "Borrowed")
                                {
                                    <a asp-controller="LoanTickets"
                                       asp-action="Print"
                                       asp-route-id="@item.Id"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">

                                        🖨️ In phiếu

                                    </a>
                                }

                            </td>


                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <!-- 7 CỘT -->

                        <td colspan="7"
                            class="text-center py-4">

                            Không tìm thấy phiếu mượn.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <style>

            .loan-table-wrapper {
                overflow-x: auto;
            }


            .loan-table {
                background-color: #ffffff;
                color: #333;
                border-color: #e0e0e0;
                width: 100%;
                border-collapse: collapse;
                margin: 0;
            }


                .loan-table thead {
                    background-color: #0052cc;
                    border-bottom: 2px solid #0052cc;
                    display: table-header-group;
                }


                    .loan-table thead tr {
                        display: table-row;
                        width: 100%;
                        background-color: #0052cc;
                    }


                .loan-table th {
                    color: #ffffff;
                    font-weight: 600;
                    padding: 15px;
                    text-align: left;
                    border: 1px solid #0052cc;
                    background-color: #0052cc;
                }


                .loan-table tbody {
                    display: table-row-group;
                }


                .loan-table td {
                    padding: 12px 15px;
                    border-color: #e0e0e0;
                    border: 1px solid #e0e0e0;
                    vertical-align: middle;
                    color: #333;
                }


            .loan-row {
                border-bottom: 1px solid #e0e0e0;
                display: table-row;
            }


                .loan-row:hover {
                    background-color: #f5f5f5;
                }


            .loan-books-display {
                display: flex;
                align-items: center;
                gap: 8px;
            }


            .btn-toggle-books {
                background: none;
                border: none;
                color: #0052cc;
                cursor: pointer;
                font-size: 16px;
                padding: 0;
                width: 24px;
                transition: transform 0.3s;
            }


                .btn-toggle-books.expanded {
                    transform: rotate(180deg);
                }


            .books-count {
                color: #666;
                font-size: 14px;
            }


            .loan-books-list {
                margin-top: 8px;
                padding: 8px 0;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }


                .loan-books-list.hidden {
                    display: none;
                }


            .book-item {
                color: #333;
                font-size: 13px;
                padding-left: 32px;
            }


                .book-item .quantity {
                    color: #0052cc;
                    font-weight: 600;
                }


            .badge {
                padding: 5px 10px;
                border-radius: 4px;
                font-size: 12px;
            }


            .bg-success {
                background-color: #28a745 !important;
                color: white !important;
            }


            .bg-warning {
                background-color: #ffc107 !important;
                color: #333 !important;
            }


            .text-center {
                text-align: center;
            }


            .py-4 {
                padding-top: 24px !important;
                padding-bottom: 24px !important;
            }

    </style>


    <script>

            function toggleLoanDetails(button) {

                const loanId =
                    button.getAttribute('data-loan-id');

                const detailsDiv =
                    document.getElementById(
                        `books-${loanId}`
                    );


                button.classList.toggle(
                    'expanded'
                );


                detailsDiv.classList.toggle(
                    'hidden'
                );

            }

    </script>

</div>