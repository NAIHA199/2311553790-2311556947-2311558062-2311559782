@model IEnumerable<LibraryAdvanced.ViewModels.NotificationViewModel>

@{
    ViewData["Title"] = "Thông báo";
}

<div class="container mt-4">

    <div class="mb-4">

        <span class="page-label">
            THƯ VIỆN
        </span>

        <h1>
            🔔 Thông báo
        </h1>

        <p class="text-muted">
            Theo dõi tình trạng hạn trả sách của bạn.
        </p>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-success">

            ✅ Hiện tại bạn không có thông báo nào.

        </div>
    }
    else
    {
        foreach (var notification in Model)
        {
            if (notification.Type == "Overdue")
            {
                <!-- QUÁ HẠN -->

                <div class="alert alert-danger mb-3">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h5>
                                🔴 Sách đã quá hạn
                            </h5>

                            <p class="mb-2">
                                @notification.Message
                            </p>


                            <!-- HẠN TRẢ -->

                            <div>

                                <strong>
                                    Hạn trả:
                                </strong>

                                @(notification.DueDate.HasValue
                                    ? notification.DueDate.Value.ToString("dd/MM/yyyy")
                                    : "Chưa có")

                            </div>


                            <!-- TỔNG SỐ SÁCH -->

                            <div>

                                <strong>
                                    Tổng số sách:
                                </strong>

                                @notification.TotalQuantity cuốn

                            </div>

                        </div>


                        <div>

                            <a asp-controller="LoanTickets"
                               asp-action="Index"
                               class="btn btn-danger">

                                Xem phiếu

                            </a>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <!-- SẮP ĐẾN HẠN -->

                <div class="alert alert-warning mb-3">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h5>
                                🟡 Sắp đến hạn trả
                            </h5>

                            <p class="mb-2">
                                @notification.Message
                            </p>


                            <!-- HẠN TRẢ -->

                            <div>

                                <strong>
                                    Hạn trả:
                                </strong>

                                @(notification.DueDate.HasValue
                                    ? notification.DueDate.Value.ToString("dd/MM/yyyy")
                                    : "Chưa có")

                            </div>


                            <!-- TỔNG SỐ SÁCH -->

                            <div>

                                <strong>
                                    Tổng số sách:
                                </strong>

                                @notification.TotalQuantity cuốn

                            </div>

                        </div>


                        <div>

                            <a asp-controller="LoanTickets"
                               asp-action="Index"
                               class="btn btn-warning">

                                Xem phiếu

                            </a>

                        </div>

                    </div>

                </div>
            }
        }
    }

</div>